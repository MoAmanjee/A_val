# Shopify custom app (Admin API scopes: write_products, read_orders, write_fulfillments, read_fulfillments)
SHOPIFY_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=

# Meta Marketing API (system user token with ads_management)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_PIXEL_ID=
TARGET_COUNTRIES=US

# Supplier: "manual" writes orders_to_place.csv; "http" POSTs JSON to SUPPLIER_ORDER_URL
SUPPLIER_MODE=manual
SUPPLIER_ORDER_URL=
SUPPLIER_API_KEY=

# Optional: LLM-written copy (templates are used if empty)
OPENAI_API_KEY=

# Pricing and safety limits (store currency)
TARGET_PROFIT_PER_ORDER=12
TEST_DAILY_BUDGET=10
MAX_DAILY_BUDGET_PER_PRODUCT=50
MAX_TOTAL_DAILY_BUDGET=100
MAX_ACTIVE_PRODUCTS=5
# Ads are created PAUSED until you flip this (or enable them in Ads Manager)
ADS_START_ACTIVE=false
