# --- Database -------------------------------------------------------------
DATABASE_URL="postgresql://autoquote:autoquote@localhost:5432/autoquote?schema=public"

# --- Auth -----------------------------------------------------------------
# Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"
# 32+ char secret used to encrypt per-business WhatsApp access tokens stored in the DB
ENCRYPTION_KEY="change-me-to-another-long-random-string"

# --- App ------------------------------------------------------------------
# Public HTTPS origin Meta will POST webhooks to. localhost is only for mock/dev.
# Example tunnel: APP_URL="https://abc123.ngrok-free.app"
APP_URL="http://localhost:3000"

# --- AI (OpenAI) ----------------------------------------------------------
# Required for automated WhatsApp replies. Without it, inbound chats are flagged for a human.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# --- WhatsApp Business Cloud API -------------------------------------------
# cloud = live Meta Cloud API (automated agent). mock = local inbox only (no Meta).
WHATSAPP_DRIVER="cloud"
WHATSAPP_GRAPH_VERSION="v21.0"
# Optional platform-level token. Prefer a per-business token in Settings → WhatsApp connection.
WHATSAPP_ACCESS_TOKEN=""
# Long random string. Paste the SAME value in Meta webhook "Verify token".
WHATSAPP_VERIFY_TOKEN="change-me"
# Meta App → Settings → Basic → App secret. Required to verify inbound webhook signatures.
WHATSAPP_APP_SECRET=""

# --- File storage (PDFs, logos) -------------------------------------------
# local = disk, s3 = any S3-compatible bucket (AWS S3, R2, MinIO, Spaces...)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# --- VIN decoding (optional) ----------------------------------------------
# basic = format validation only, nhtsa = NHTSA vPIC (mostly North American vehicles)
VIN_DECODER="basic"
