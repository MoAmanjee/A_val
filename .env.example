# --- Database -------------------------------------------------------------
DATABASE_URL="postgresql://machachos:machachos@localhost:5432/machachos?schema=public"

# --- Auth (kitchen display) -----------------------------------------------
# Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"
# 32+ chars. Encrypts the WhatsApp access token stored in the database.
ENCRYPTION_KEY="change-me-to-another-long-random-string"
# PIN the kitchen tablet uses to open the order screen.
KITCHEN_PIN="1234"

# --- App ------------------------------------------------------------------
# Public HTTPS origin Meta will POST webhooks to. localhost is only for mock/dev.
# Example tunnel: APP_URL="https://abc123.ngrok-free.app"
APP_URL="http://localhost:3000"

# --- AI (OpenAI) ----------------------------------------------------------
# Understands free-text orders and answers customer questions. Without it the
# bot still takes orders through the menu buttons, but free text is handed to staff.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# --- WhatsApp Business Cloud API ------------------------------------------
# cloud = live Meta Cloud API. mock = in-memory driver for local dev and tests.
# npm run local forces mock so the /playground page can stand in for WhatsApp.
WHATSAPP_DRIVER="cloud"
# true = take orders outside trading hours. npm run local sets this.
FORCE_OPEN="false"
WHATSAPP_GRAPH_VERSION="v21.0"
# WhatsApp > API Setup > Phone number ID for the Machachos Potch number.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
# Long random string. Paste the SAME value in Meta webhook "Verify token".
WHATSAPP_VERIFY_TOKEN="change-me"
# Meta App > Settings > Basic > App secret. Verifies inbound webhook signatures.
WHATSAPP_APP_SECRET=""
