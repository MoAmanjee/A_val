# --- Database -------------------------------------------------------------
DATABASE_URL="postgresql://autoquote:autoquote@localhost:5432/autoquote?schema=public"

# --- Auth -----------------------------------------------------------------
# Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"
# 32+ char secret used to encrypt per-business WhatsApp access tokens stored in the DB
ENCRYPTION_KEY="change-me-to-another-long-random-string"

# --- App ------------------------------------------------------------------
APP_URL="http://localhost:3000"

# --- AI (OpenAI) ----------------------------------------------------------
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# --- WhatsApp Business Cloud API -------------------------------------------
# cloud = official Meta Cloud API, mock = in-memory driver for local development/tests
WHATSAPP_DRIVER="cloud"
WHATSAPP_GRAPH_VERSION="v21.0"
# Default (platform-level) access token. Businesses can override with their own in Settings.
WHATSAPP_ACCESS_TOKEN=""
# Token you configure in the Meta webhook settings (GET verification handshake)
WHATSAPP_VERIFY_TOKEN="change-me"
# Meta app secret used to verify X-Hub-Signature-256 on incoming webhooks
WHATSAPP_APP_SECRET=""

# --- File storage (PDFs, logos) -------------------------------------------
# local = disk, s3 = any S3-compatible bucket (AWS S3, R2, MinIO, Spaces...)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# --- VIN decoding (optional) ----------------------------------------------
# basic = format validation only, nhtsa = NHTSA vPIC (mostly North American vehicles)
VIN_DECODER="basic"
