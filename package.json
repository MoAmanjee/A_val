{
  "name": "machachos-order-bot",
  "version": "0.1.0",
  "private": true,
  "description": "WhatsApp ordering agent and kitchen display for Machachos Potchefstroom",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "local": "bash scripts/local-up.sh",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "build:app": "prisma generate && next build",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "menu:import": "tsx scripts/import-menu.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@stripe/react-stripe-js": "^7.0.0",
    "@stripe/stripe-js": "^10.1.0",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "jose": "^6.0.0",
    "lucide-react": "^0.475.0",
    "next": "^15.5.26",
    "openai": "^5.23.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "postcss": "^8.5.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
