generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  BUSINESS_ADMIN
  STAFF
}

enum ConversationStatus {
  ACTIVE
  WAITING_FOR_CUSTOMER
  QUOTE_PENDING
  QUOTE_APPROVAL
  HUMAN_REQUIRED
  COMPLETED
  CLOSED
}

enum ConversationHandler {
  AI
  HUMAN
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageSender {
  CUSTOMER
  AI
  BUSINESS
  SYSTEM
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  DOCUMENT
  LOCATION
  OTHER
  NOTE
}

enum DeliveryStatus {
  RECEIVED
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum QuotationSource {
  AI
  MANUAL
}

enum OptionDisplayMode {
  CHEAPEST
  RECOMMENDED
  ALL
  BUSINESS_SELECTED
}

enum ContactMethod {
  WHATSAPP
  EMAIL
  PHONE
}

enum PartRequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

// ---------------------------------------------------------------------------
// Tenancy & auth
// ---------------------------------------------------------------------------

model Business {
  id                     String            @id @default(cuid())
  name                   String
  tradingName            String?
  registrationNumber     String?
  vatNumber              String?
  address                String?
  phone                  String?
  email                  String?
  logoKey                String?
  logoUrl                String?
  currency               String            @default("ZAR")
  currencySymbol         String            @default("R")
  locale                 String            @default("en-ZA")
  // WhatsApp
  whatsappNumber         String?
  whatsappPhoneNumberId  String?           @unique
  whatsappAccessTokenEnc String?
  // Quoting configuration
  vatRate                Decimal           @default(15) @db.Decimal(5, 2)
  pricesIncludeVat       Boolean           @default(false)
  quotePrefix            String            @default("QT")
  quoteValidityDays      Int               @default(7)
  optionDisplayMode      OptionDisplayMode @default(ALL)
  paymentDetails         String?
  termsAndConditions     String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  users          User[]
  customers      Customer[]
  vehicles       Vehicle[]
  parts          Part[]
  labourRates    LabourRate[]
  conversations  Conversation[]
  quotations     Quotation[]
  partRequests   PartRequest[]
  auditLogs      AuditLog[]
  quoteSequences QuoteSequence[]

  @@map("businesses")
}

model User {
  id           String   @id @default(cuid())
  businessId   String?
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STAFF)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business           Business?   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  quotationsCreated  Quotation[] @relation("QuotationCreatedBy")
  quotationsApproved Quotation[] @relation("QuotationApprovedBy")
  auditLogs          AuditLog[]

  @@index([businessId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// CRM
// ---------------------------------------------------------------------------

model Customer {
  id                     String        @id @default(cuid())
  businessId             String
  name                   String?
  phone                  String
  email                  String?
  preferredContactMethod ContactMethod @default(WHATSAPP)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  vehicles      Vehicle[]
  conversations Conversation[]
  quotations    Quotation[]
  partRequests  PartRequest[]

  @@unique([businessId, phone])
  @@index([businessId, name])
  @@map("customers")
}

model Vehicle {
  id                 String   @id @default(cuid())
  businessId         String
  customerId         String?
  vin                String?
  registrationNumber String?
  make               String?
  model              String?
  year               Int?
  variant            String?
  engine             String?
  engineCode         String?
  engineSize         String?
  fuelType           String?
  transmission       String?
  mileage            Int?
  vinDecoded         Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  conversations Conversation[]
  quotations    Quotation[]
  partRequests  PartRequest[]

  @@index([businessId, customerId])
  @@index([businessId, vin])
  @@index([businessId, make, model])
  @@map("vehicles")
}

// ---------------------------------------------------------------------------
// Inventory & fitment
// ---------------------------------------------------------------------------

model Part {
  id                String   @id @default(cuid())
  businessId        String
  sku               String
  partNumber        String?
  barcode           String?
  name              String
  description       String?
  category          String?
  manufacturer      String?
  costPrice         Decimal  @default(0) @db.Decimal(12, 2)
  sellingPrice      Decimal  @default(0) @db.Decimal(12, 2)
  vatRate           Decimal? @db.Decimal(5, 2)
  quantityInStock   Int      @default(0)
  minimumStockLevel Int      @default(0)
  location          String?
  active            Boolean  @default(true)
  // Universal parts (oil, wipers, ...) need no fitment rows.
  universal         Boolean  @default(false)
  // Business-configured "recommended" flag, used by OptionDisplayMode.RECOMMENDED.
  recommended       Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  fitments   VehicleFitment[]
  quoteItems QuotationItem[]

  @@unique([businessId, sku])
  @@index([businessId, partNumber])
  @@index([businessId, category])
  @@index([businessId, active])
  @@index([businessId, barcode])
  @@map("parts")
}

model VehicleFitment {
  id           String  @id @default(cuid())
  partId       String
  make         String
  model        String?
  yearFrom     Int?
  yearTo       Int?
  variant      String?
  engine       String?
  engineCode   String?
  fuelType     String?
  transmission String?
  notes        String?

  part Part @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@index([partId])
  @@index([make, model])
  @@map("vehicle_fitment")
}

model LabourRate {
  id           String   @id @default(cuid())
  businessId   String
  name         String
  description  String?
  hourlyRate   Decimal? @db.Decimal(12, 2)
  fixedPrice   Decimal? @db.Decimal(12, 2)
  // Default number of hours when the rate is hourly.
  defaultHours Decimal  @default(1) @db.Decimal(6, 2)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  quoteLines QuotationLabour[]

  @@index([businessId, active])
  @@map("labour_rates")
}

// ---------------------------------------------------------------------------
// Conversations
// ---------------------------------------------------------------------------

model Conversation {
  id               String              @id @default(cuid())
  businessId       String
  customerId       String
  vehicleId        String?
  whatsappNumber   String
  status           ConversationStatus  @default(ACTIVE)
  handler          ConversationHandler @default(AI)
  humanRequestedAt DateTime?
  humanReason      String?
  unreadCount      Int                 @default(0)
  lastMessageAt    DateTime            @default(now())
  startedAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle      Vehicle?      @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  messages     Message[]
  quotations   Quotation[]
  partRequests PartRequest[]

  @@index([businessId, status])
  @@index([businessId, lastMessageAt])
  @@index([businessId, customerId])
  @@map("conversations")
}

model Message {
  id                String           @id @default(cuid())
  conversationId    String
  direction         MessageDirection
  sender            MessageSender
  messageType       MessageType      @default(TEXT)
  content           String
  whatsappMessageId String?          @unique
  deliveryStatus    DeliveryStatus   @default(RECEIVED)
  error             String?
  attachmentKey     String?
  createdAt         DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// Quotations
// ---------------------------------------------------------------------------

model QuoteSequence {
  businessId String
  year       Int
  last       Int    @default(0)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([businessId, year])
  @@map("quote_sequences")
}

model Quotation {
  id                String          @id @default(cuid())
  businessId        String
  customerId        String
  vehicleId         String?
  conversationId    String?
  quoteNumber       String
  status            QuotationStatus @default(DRAFT)
  source            QuotationSource @default(MANUAL)
  subtotal          Decimal         @default(0) @db.Decimal(12, 2)
  discount          Decimal         @default(0) @db.Decimal(12, 2)
  vat               Decimal         @default(0) @db.Decimal(12, 2)
  labourTotal       Decimal         @default(0) @db.Decimal(12, 2)
  total             Decimal         @default(0) @db.Decimal(12, 2)
  // Snapshot of pricing configuration used to compute the totals.
  vatRate           Decimal         @default(15) @db.Decimal(5, 2)
  pricesIncludeVat  Boolean         @default(false)
  validUntil        DateTime?
  notes             String?
  // Internal notes for the business (never shown to the customer / PDF).
  internalNotes     String?
  createdById       String?
  approvedById      String?
  approvedAt        DateTime?
  sentAt            DateTime?
  pdfKey            String?
  pdfUrl            String?
  whatsappMessageId String?
  sendError         String?
  lastSendAttemptAt DateTime?
  respondedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  business     Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer     Customer          @relation(fields: [customerId], references: [id])
  vehicle      Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  conversation Conversation?     @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  createdBy    User?             @relation("QuotationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy   User?             @relation("QuotationApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  items        QuotationItem[]
  labour       QuotationLabour[]

  @@unique([businessId, quoteNumber])
  @@index([businessId, status])
  @@index([businessId, createdAt])
  @@index([businessId, customerId])
  @@index([conversationId])
  @@map("quotations")
}

model QuotationItem {
  id                String  @id @default(cuid())
  quotationId       String
  position          Int     @default(0)
  partId            String?
  description       String
  sku               String?
  partNumber        String?
  quantity          Decimal @db.Decimal(10, 2)
  unitPrice         Decimal @db.Decimal(12, 2)
  discount          Decimal @default(0) @db.Decimal(12, 2)
  vatRate           Decimal @default(0) @db.Decimal(5, 2)
  // VAT amount for the line; `total` is the line price basis (qty x unit - discount).
  vat               Decimal @default(0) @db.Decimal(12, 2)
  total             Decimal @db.Decimal(12, 2)
  // AI / matching metadata surfaced to the business reviewer.
  fitmentConfidence String?
  matchNote         String?
  alternatives      Json?

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  part      Part?     @relation(fields: [partId], references: [id], onDelete: SetNull)

  @@index([quotationId])
  @@map("quotation_items")
}

model QuotationLabour {
  id          String  @id @default(cuid())
  quotationId String
  position    Int     @default(0)
  labourId    String?
  description String
  hours       Decimal @db.Decimal(8, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  vatRate     Decimal @default(0) @db.Decimal(5, 2)
  vat         Decimal @default(0) @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  quotation Quotation   @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  labour    LabourRate? @relation(fields: [labourId], references: [id], onDelete: SetNull)

  @@index([quotationId])
  @@map("quotation_labour")
}

// ---------------------------------------------------------------------------
// Leads & audit
// ---------------------------------------------------------------------------

model PartRequest {
  id             String            @id @default(cuid())
  businessId     String
  customerId     String?
  vehicleId      String?
  conversationId String?
  description    String
  notes          String?
  status         PartRequestStatus @default(OPEN)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  vehicle      Vehicle?      @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([businessId, status])
  @@map("part_requests")
}

model AuditLog {
  id         String   @id @default(cuid())
  businessId String?
  // null userId = system or AI actor
  userId     String?
  actor      String   @default("USER")
  action     String
  entityType String
  entityId   String?
  summary    String?
  details    Json?
  createdAt  DateTime @default(now())

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([businessId, entityType, entityId])
  @@map("audit_logs")
}
